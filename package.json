{
  "name": "veilio-oss",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "description": "Veilio Community Edition — self-hostable, frontend-only AI code anonymizer",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "private": true,
  "//workspaces": "packages/engine is published by semantic-release on an engine-v tag; packages/cli and packages/mcp are published by Changesets. Two release tools, one per package set, and .changeset/config.json names the engine in `ignore` so they cannot both claim it.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "postinstall": "npm run build --workspace=packages/engine",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint src e2e packages/*/src packages/*/tests",
    "lint:fix": "eslint src e2e packages/*/src packages/*/tests --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" \"packages/*/{src,tests}/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" \"packages/*/{src,tests}/**/*.ts\"",
    "verify": "npm run lint && npm run format:check",
    "prepare": "husky || true",
    "build:packages": "npm run build --workspace=packages/engine && npm run build --workspace=packages/cli && npm run build --workspace=packages/mcp",
    "test:packages": "npm run build:packages && npm run test --workspaces --if-present",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build:packages && changeset publish"
  },
  "dependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@uiw/codemirror-themes": "^4.25.11",
    "@uiw/react-codemirror": "^4.25.11",
    "@veilio-inc/engine": "*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.63.0",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/git": "11.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "conventional-changelog-conventionalcommits": "9.1.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.8",
    "semantic-release": "25.0.9",
    "typescript": "^5.4.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
