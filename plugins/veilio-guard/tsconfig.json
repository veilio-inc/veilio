{
  // Type-checks the guard's modules (lib/) and its hooks (hooks/) in CI, where
  // Claude Code's generated mod types (.claude-plugin/types, written on load
  // and ignored by git) do not exist: the hooks are typed by lib/host.ts.
  // Claude Code runs tests/, and `claude plugin test` checks those.
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": ["lib", "hooks"]
}
