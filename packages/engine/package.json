{
  "name": "@dlgshi/engine",
  "version": "1.0.0",
  "description": "Two-way code anonymizer: replace real identifiers with __P1__ tokens before sending source code to an LLM, restore them afterward. Pure, local, no network, no telemetry, zero runtime dependencies.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dependencies": {},
  "sideEffects": false,
  "license": "PolyForm-Shield-1.0.0",
  "author": "Igor Dlugosh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DlgSHi/veilio-oss.git",
    "directory": "packages/engine"
  },
  "bugs": {
    "url": "https://github.com/DlgSHi/veilio-oss/issues"
  },
  "homepage": "https://github.com/DlgSHi/veilio-oss/tree/main/packages/engine#readme",
  "keywords": [
    "anonymizer",
    "llm",
    "ai",
    "privacy",
    "code",
    "identifiers",
    "redaction",
    "veilio"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run clean && npm run build && npm test"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
