{
  "name": "@veilio-inc/mcp",
  "version": "0.2.0",
  "description": "MCP server exposing the anonymizer to coding agents, so a model can work on masked code without the real identifiers ever entering its context.",
  "type": "module",
  "bin": {
    "veilio-mcp": "dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "anonymizer",
    "llm",
    "privacy",
    "secret-scanning",
    "veilio"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@veilio-inc/engine": "^1.6.2",
    "@veilio-inc/cli": "^0.2.0"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run typecheck && npm run build && npm run test",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^5.0.1",
    "@vitest/coverage-v8": "^5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/veilio-inc/veilio.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/veilio-inc/veilio/issues"
  },
  "homepage": "https://github.com/veilio-inc/veilio/tree/main/packages/mcp#readme",
  "publishConfig": {
    "access": "public"
  }
}
