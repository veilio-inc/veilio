{
  "name": "@veilio-inc/cli",
  "version": "0.3.0",
  "description": "Anonymize identifiers and redact credentials in source code before it reaches an LLM \u2014 from the terminal, a pipe, or a pre-commit hook.",
  "type": "module",
  "bin": {
    "veilio": "dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "anonymizer",
    "llm",
    "ai",
    "privacy",
    "secret-scanning",
    "pre-commit",
    "cli",
    "veilio"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@veilio-inc/engine": "^1.6.2"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run typecheck && npm run build && npm run test",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.1",
    "typescript": "^5.4.0",
    "vitest": "^5.0.1"
  },
  "exports": {
    ".": "./dist/index.js",
    "./store": "./dist/store.js",
    "./credential": "./dist/credential.js",
    "./cloud": "./dist/cloud.js",
    "./team-unlock": "./dist/team-unlock.js",
    "./rules": "./dist/rules.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/veilio-inc/veilio.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/veilio-inc/veilio/issues"
  },
  "homepage": "https://github.com/veilio-inc/veilio/tree/main/packages/cli#readme",
  "publishConfig": {
    "access": "public"
  }
}
