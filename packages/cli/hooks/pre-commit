#!/bin/sh
# Veilio pre-commit hook — blocks a commit that would leak a credential.
#
# Install:
#   cp packages/cli/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
#
# Or, if you use the pre-commit framework, prefer .pre-commit-hooks.yaml instead.
#
# Scans what is STAGED, not the working tree: what you are about to commit is
# the thing that matters, and a finding in an unstaged scratch file shouldn't
# block you. Each staged file is scanned on its own, under its own name, so its
# file type picks the rules (.env, YAML, shell); a .gitattributes `-diff` hides
# nothing, because the file's content is read, not its diff.

set -eu

if ! command -v veilio >/dev/null 2>&1; then
  echo "veilio: not installed — skipping credential scan." >&2
  echo "  npm install -g @veilio-inc/cli" >&2
  exit 0
fi

# Everything the index changes except deletions, renames off (a rename is its
# new path, added), NUL-separated so any file name is passed as it is.
list() { git diff --cached --name-only --no-renames -z --diff-filter=d; }
[ "$(list | head -c 1 | wc -c)" -eq 0 ] && exit 0

# One staged file, given as $1. Exits 1 on a finding.
scan_one='
  p=$1
  # A submodule (mode 160000) is a commit of another repository: no blob to scan.
  case "$(git --literal-pathspecs ls-files -s -- "$p")" in 160000\ *) exit 0 ;; esac
  # Fail closed: a blob git cannot show is not passed as an empty one.
  git cat-file -e ":$p" 2>/dev/null || { echo "veilio: cannot read the staged $p" >&2; exit 1; }
  # A NUL in the first 8000 bytes is a binary file, as git decides it.
  all=$(git cat-file blob ":$p" | head -c 8000 | wc -c)
  text=$(git cat-file blob ":$p" | head -c 8000 | tr -d "\\000" | wc -c)
  [ "$all" -ne "$text" ] && exit 0
  case "$p" in -*) name="./$p" ;; *) name=$p ;; esac
  git cat-file blob ":$p" | veilio scan --quiet --name "$name"
'
if list | xargs -0 -n 1 sh -c "$scan_one" sh; then
  exit 0
fi

cat >&2 <<'MSG'

Commit blocked: credentials detected in the staged changes.

  - Remove the value and use an environment variable or a secret manager.
  - Treat the credential as compromised and rotate it. Anything that reached
    your clipboard, an editor buffer, or a model's context should be assumed
    exposed even if it never lands in a commit.
  - To override for a change you are certain about: git commit --no-verify

MSG
exit 1
